            },
            "url": "{{base_adopciones}}/auth/login"
          }
        },
        {
          "name": "Adopciones pendientes",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token_adopciones}}" }
            ],
            "url": "{{base_adopciones}}/api/adopciones/pendientes"
          }
        },
        {
          "name": "Detalle de adopción",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token_adopciones}}" }
            ],
            "url": "{{base_adopciones}}/api/adopciones/1"
          }
        },
        {
          "name": "Registrar adopción",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token_adopciones}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario_id\": 2,\n  \"mascota_id\": 2,\n  \"motivo\": \"Deseo adoptar un perro protector para mi hogar\",\n  \"lugar_mascota\": \"Casa con patio en Popayan\",\n  \"personas_casa\": 3,\n  \"tiene_otras_mascotas\": false,\n  \"experiencia\": \"Experiencia previa con perros\",\n  \"responsable\": \"Carlos Perez\"\n}"
            },
            "url": "{{base_adopciones}}/api/adopciones"
          }
        },
        {
          "name": "Cambiar estado",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token_adopciones}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"Entrevista\"\n}"
            },
            "url": "{{base_adopciones}}/api/adopciones/1/estado"
          }
        },
        {
          "name": "Programar entrevista",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token_adopciones}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fecha\": \"2026-10-25\",\n  \"hora\": \"11:30:00\",\n  \"modalidad\": \"Virtual\",\n  \"observaciones\": \"Confirmar disponibilidad del adoptante\"\n}"
            },
            "url": "{{base_adopciones}}/api/adopciones/4/entrevista"
          }
        },
        {
          "name": "Entrevistas próximas",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token_adopciones}}" }
            ],
            "url": "{{base_adopciones}}/api/entrevistas/proximas"
          }
        },
        {
          "name": "Seguridad - token inválido (401)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer token_invalido" }
            ],
            "url": "{{base_adopciones}}/api/adopciones/pendientes"
          }
        }
      ]
    },
    {
      "name": "3. Microservicio Veterinario (8002)",
      "item": [
        {
          "name": "Login",
